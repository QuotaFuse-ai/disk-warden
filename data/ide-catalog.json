          "path": "%APPDATA%\\Cursor\\logs\\",
          "type": "dir",
          "safety": "green",
          "reason": "运行日志，0.1~1 GB，可再生"
        },
        {
          "path": "%APPDATA%\\Cursor\\CachedExtensions\\",
