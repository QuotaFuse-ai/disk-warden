          "safety": "green",
          "reason": "各项目工作区数据，3~40 GB，可迁"
        },
        {
          "path": "%APPDATA%\\Cursor\\CachedData\\",
          "type": "dir",
          "safety": "green",
          "reason": "编译缓存，0.5~2 GB，可再生"
        },
        {
          "path": "%APPDATA%\\Cursor\\Cache\\",
          "type": "dir",
          "safety": "green",
          "reason": "Chromium 浏览器缓存，1~5 GB，可再生"
