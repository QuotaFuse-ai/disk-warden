      "platform": "windows",
      "processes": ["Cursor.exe"],
      "notes": "worktrees 由 Parallel Agents 自动创建，官方不支持改路径；globalStorage 为绿色但迁移时需注意其中可能包含登录态。",
      "directories": [
        {
          "path": "%APPDATA%\\Cursor\\User\\globalStorage\\state.vscdb",
          "type": "file",
          "safety": "green",
          "reason": "AI 对话/agent 数据库，体积可达数十 GB，可迁"
        },
        {
          "path": "%APPDATA%\\Cursor\\User\\workspaceStorage\\*.pack",
          "type": "glob",
          "safety": "green",
          "reason": "语言服务器包文件，单文件可超 1 GB，累计可达 72 GB，可迁"
