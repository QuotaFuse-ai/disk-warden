<?xml version="1.0" encoding="utf-8"?>
<!--
  The zip is delivered as a browser download, so Windows marks every extracted
  file with Mark-of-the-Web.  The CLR then refuses Assembly.LoadFrom() for the
  bundled pythonnet runtime (Python.Runtime.dll) and pythonnet fails with
  "Failed to resolve Python.Runtime.Loader.Initialize".  Allowing load-from-
  remote makes an extracted build behave exactly like an unzipped local one.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
